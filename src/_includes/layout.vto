<!doctype html>
<html lang="en" class="theme-dark tenebrism{{ if url == "/" }} home{{ /if }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ (title ?? basename) == "Tenebrous Dragon" ? "A Tenebrous Dragon" : (title ?? basename) + " | Tenebrous Dragon" }}</title>
  {{ if description }}<meta name="description" content="{{ description }}">{{ /if }}
  {{ set img = typeof socialImage === "function" ? socialImage(it) : socialImage }}
  {{ set imgAlt = typeof socialAlt === "function" ? socialAlt(it) : socialAlt }}
  <link rel="canonical" href="https://tenebrousdragon.com{{ url }}">
  <link rel="alternate" type="application/rss+xml" title="Tenebrous Dragon" href="/index.xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="196x196" href="/static/favicon-196x196.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/favicon-180x180.png">
  <meta property="og:site_name" content="Tenebrous Dragon">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title ?? basename }}">
  <meta property="og:description" content="{{ description ?? title ?? basename }}">
  <meta property="og:url" content="https://tenebrousdragon.com{{ url }}">
  <meta property="og:image" content="https://tenebrousdragon.com{{ img }}">
  <meta property="og:image:alt" content="{{ imgAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/site.css">
  <link rel="preload" href="/static/fonts/alegreya-sans-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <script src="/static/lightbox.js" defer></script>
  <script src="/static/back-to-top.js" defer></script>
  <script src="/static/callouts.js" defer></script>
  <script src="/static/search.js" defer></script>
  <script src="/static/popover.js" defer></script>
  {{ if map }}<script src="/static/base-map.js" defer></script>{{ /if }}
</head>
<body>
  <header class="site-header"><a class="site-header-text" href="/">A Tenebrous Dragon</a></header>
  <div class="page">
    <div class="sidebar left">
      <nav aria-label="Site" style="display:contents">
      <div class="site-dragon"><img src="/static/tenebrous-dragon.png" alt="" width="520" height="567"></div>
      {{ include "social.html" }}
      <button type="button" class="search-button" aria-label="Search (press /)"><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><span>Search</span><kbd>/</kbd></button>
      </nav>
      {{ if url == "/" }}
      <nav class="site-nav" aria-label="Pages">
        <h2>Pages</h2>
        <ul>{{ for item of navigation }}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{{ /for }}</ul>
      </nav>
      {{ /if }}
    </div>
    <main class="center">
      <article class="markdown-reading-view{{ if cssclasses }} {{ cssclasses.join(" ") }}{{ /if }}">
        {{ content }}
      </article>
    </main>
    <div class="sidebar right"></div>
    <footer>
      <p>© 2026 <a href="/sigrunixia/">Rebbecca Bishop (Sigrunixia)</a></p>
      <p>Written in <a href="https://obsidian.md" class="external">Obsidian</a>, Hosted on <a href="https://www.cloudflare.com" class="external">Cloudflare</a> via <a href="https://lume.land" class="external">Lume</a>, and still holding.</p>
      <p>Updated {{ buildDate }}{{ if commitCount }} - Commit <a href="https://github.com/sigrunixia/Tenebrous-Site/commit/{{ commitHash }}">{{ commitCount }}</a>{{ /if }}</p>
      <ul><li><a href="/about-this-site/">About this site</a></li><li><a href="/site-map/">Site map</a></li><li><a href="/privacy-notice/">Privacy</a></li></ul>
    </footer>
  </div>
  <button type="button" class="back-to-top" aria-label="Back to top" hidden><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg></button>
</body>
</html>
